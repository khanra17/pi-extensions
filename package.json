{
  "name": "@khanra17/pi-dictation",
  "description": "Editable progressive microphone dictation for Pi",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./packages/dictation/index.ts"
    ]
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "files": [
    "packages/dictation/*.ts",
    "shared/*.ts",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    ".gitleaks.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanra17/pi-extensions.git",
    "directory": "packages/dictation"
  }
}
