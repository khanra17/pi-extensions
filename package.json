{
  "name": "@khanra17/pi-live-voice",
  "description": "Conversational Codex Live voice for Pi",
  "license": "MIT",
  "dependencies": {
    "https-proxy-agent": "9.1.0",
    "proxy-from-env": "2.1.0",
    "undici": "8.11.2",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-darwin-arm64": "17.2.12",
    "@oh-my-pi/pi-natives-darwin-x64": "17.2.12",
    "@oh-my-pi/pi-natives-linux-arm64": "17.2.12",
    "@oh-my-pi/pi-natives-linux-x64": "17.2.12",
    "@oh-my-pi/pi-natives-win32-x64": "17.2.12"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./packages/live/index.ts"
    ]
  },
  "files": [
    "packages/live/*.ts",
    "shared/*.ts",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    ".gitleaks.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanra17/pi-extensions.git",
    "directory": "packages/live"
  }
}
