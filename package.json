{
  "name": "@khanra17/pi-read-aloud",
  "description": "Edge voice read-aloud with terminal playback controls",
  "license": "LGPL-3.0-or-later",
  "dependencies": {
    "@soundtouchjs/audio-worklet": "2.1.1",
    "node-web-audio-api": "1.0.9",
    "ws": "8.21.3"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./packages/read-aloud/index.ts"
    ]
  },
  "files": [
    "packages/read-aloud/*.ts",
    "shared/*.ts",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    ".gitleaks.toml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanra17/pi-extensions.git",
    "directory": "packages/read-aloud"
  }
}
