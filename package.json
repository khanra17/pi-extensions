{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "package:git": "node scripts/git-packages.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.12.4",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "tsx": "4.20.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./packages/dictation/index.ts",
      "./packages/live/index.ts",
      "./packages/read-aloud/index.ts",
      "./packages/codex-fast/index.ts"
    ]
  }
}
